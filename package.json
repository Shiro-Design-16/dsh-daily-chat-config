{
  "name": "dsh-daily-chat-config",
  "version": "0.2.0",
  "description": "在「插件」页里编辑 daily agent preset 的子条目列表（persona 与工具组合），内存挂载生效，不写任何文件 —— Edit the daily agent preset's sub-entry list from DSH's Plugins page (in-memory, writes no files)",
  "license": "MIT",
  "author": "Shiro-Design-16",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shiro-Design-16/dsh-daily-chat-config.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-preset"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  }
}
